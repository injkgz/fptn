{
	"luci-app-fptn": {
		"description": "Grant access to the FPTN client configuration",
		"read": {
			"uci": [ "fptn", "firewall", "dhcp" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/sbin/logread": [ "exec" ],
				"/sbin/ip": [ "exec" ],
				"/bin/ping": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "fptn" ],
			"file": {
				"/etc/init.d/fptn": [ "exec" ]
			}
		}
	}
}
